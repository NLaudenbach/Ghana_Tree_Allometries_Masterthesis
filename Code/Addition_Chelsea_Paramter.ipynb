    "\n",
    "# ============================================================\n",
    "# TROCKENMONATE AUS CHELSA BERECHNEN\n",
    "# ============================================================\n",
    "\n",
    "# Monatliche Niederschlags- und PET-Werte\n",
    "monthly_dry = monthly_climatology[\n",
    "    [\"plot\", \"month\", \"pr\", \"pet\"]\n",
    "].copy()\n",
    "\n",
    "# Prüfen, ob für jeden Plot 12 Monate vorhanden sind\n",
    "assert monthly_dry.groupby(\"plot\")[\"month\"].nunique().eq(12).all()\n",
    "assert monthly_dry[[\"pr\", \"pet\"]].notna().all().all()\n",
    "\n",
    "# Klimatischer Trockenmonat: Niederschlag < PET\n",
    "monthly_dry[\"Dry_Month_CHEL\"] = (\n",
    "    monthly_dry[\"pr\"] < monthly_dry[\"pet\"]\n",
    ")\n",
    "\n",
    "# Anzahl trockener Monate und Jahresniederschlag pro Plot\n",
    "dry_summary = (\n",
    "    monthly_dry.groupby(\"plot\", as_index=False)\n",
    "    .agg(\n",
    "        Dry_Months_CHEL=(\"Dry_Month_CHEL\", \"sum\"),\n",
    "        Annual_Precipitation_Check_CHEL=(\"pr\", \"sum\")\n",
    "    )\n",
    ")\n",
    "\n",
    "# Vorläufige Zuordnung nach Djomo (2016)\n",
    "def classify_djomo(row):\n",
    "    p = row[\"Annual_Precipitation_Check_CHEL\"]\n",
    "    m = row[\"Dry_Months_CHEL\"]\n",
    "\n",
    "    if p < 1000 and m > 5:\n",
    "        return \"Dry\"\n",
    "    elif p > 1500 and m <= 3:\n",
    "        return \"Moist\"\n",
    "    elif 1000 <= p <= 1500 and 3 <= m <= 5:\n",
    "        return \"Wet\"\n",
    "    else:\n",
    "        return \"unclassified\"\n",
    "\n",
    "dry_summary[\"Djomo_Forest_Type_CHEL\"] = (\n",
    "    dry_summary.apply(classify_djomo, axis=1)\n",
    ")\n",
    "\n",
    "# Ergebnisse an die bestehende CHELSA-Tabelle anhängen\n",
    "chelsa_final = chelsa_final.merge(\n",
    "    dry_summary[\n",
    "        [\"plot\", \"Dry_Months_CHEL\", \"Djomo_Forest_Type_CHEL\"]\n",
    "    ],\n",
    "    on=\"plot\",\n",
    "    how=\"left\",\n",
    "    validate=\"one_to_one\"\n",
    ")\n",
    "\n",
    "print(\"Trockenmonate und Waldtypen:\")\n",
    "display(dry_summary)\n"
   ]
  },
