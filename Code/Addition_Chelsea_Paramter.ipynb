    "import geopandas as gpd\n",
    "import pandas as pd\n",
    "\n",
    "# ============================================================\n",
    "# STEMMAP-PFADE UND PLOTNAMEN\n",
    "# ============================================================\n",
    "\n",
    "stemmap_files = {\n",
    "    \"ANK-1\": r\"Z:\\Ghana\\Stemmaps_Ghana_2026\\Stemmaps_new\\AN1_SM_new\\AN1_SM_final.shp\",\n",
    "    \"BOB-1\": r\"Z:\\Ghana\\Stemmaps_Ghana_2026\\Stemmaps_new\\BO1_SM_new\\BO1_SM_final.shp\",\n",
    "    \"BOB-2\": r\"Z:\\Ghana\\Stemmaps_Ghana_2026\\Stemmaps_new\\BO2_SM_new\\BO2_SM_final.shp\",\n",
    "    \"KOG-2\": r\"Z:\\Ghana\\Stemmaps_Ghana_2026\\Stemmaps_new\\KO2_SM_new\\KO2_SM_final.shp\",\n",
    "    \"KOG-4\": r\"Z:\\Ghana\\Stemmaps_Ghana_2026\\Stemmaps_new\\KO4_SM_new\\KO4_SM_final.shp\",\n",
    "    \"KOG-5\": r\"Z:\\Ghana\\Stemmaps_Ghana_2026\\Stemmaps_new\\SAV_SM_new\\SAV_SM_final.shp\",\n",
    "}\n",
    "\n",
    "# ============================================================\n",
    "# HILFSFUNKTION:\n",
    "# AUS POINT ODER MULTIPOINT EINEN EINZELNEN PUNKT HOLEN\n",
    "# ============================================================\n",
    "\n",
    "def get_first_point(geometry):\n",
    "    if geometry.geom_type == \"Point\":\n",
    "        return geometry\n",
    "\n",
    "    elif geometry.geom_type == \"MultiPoint\":\n",
    "        return list(geometry.geoms)[0]\n",
    "\n",
    "    else:\n",
    "        raise ValueError(\n",
    "            f\"Nicht unterstützter Geometrietyp: {geometry.geom_type}\"\n",
    "        )\n",
    "\n",
    "# ============================================================\n",
    "# KOORDINATEN FÜR ALLE PLOTS AUSLESEN\n",
    "# ============================================================\n",
    "\n",
    "results = []\n",
    "\n",
    "for plot_name, file_path in stemmap_files.items():\n",
    "\n",
    "    print(f\"Verarbeite: {plot_name}\")\n",
    "\n",
    "    # Shapefile laden\n",
    "    gdf = gpd.read_file(file_path)\n",
    "\n",
    "    # Ungültige / leere Geometrien entfernen\n",
    "    gdf = gdf[\n",
    "        gdf.geometry.notna() &\n",
    "        ~gdf.geometry.is_empty\n",
    "    ].copy()\n",
    "\n",
    "    # Prüfen, ob ein CRS vorhanden ist\n",
    "    if gdf.crs is None:\n",
    "        raise ValueError(\n",
    "            f\"{plot_name}: Kein Koordinatensystem im Shapefile hinterlegt.\"\n",
    "        )\n",
    "\n",
    "    # Erste gültige Geometrie holen\n",
    "    geom_utm = gdf.geometry.iloc[0]\n",
    "\n",
    "    # Falls MultiPoint -> ersten Einzelpunkt nehmen\n",
    "    point_utm = get_first_point(geom_utm)\n",
    "\n",
    "    # In WGS84 / Latitude-Longitude transformieren\n",
    "    gdf_wgs84 = gdf.to_crs(epsg=4326)\n",
    "\n",
    "    geom_wgs84 = gdf_wgs84.geometry.iloc[0]\n",
    "    point_wgs84 = get_first_point(geom_wgs84)\n",
    "\n",
    "    # Ergebnisse speichern\n",
    "    results.append({\n",
    "        \"plot\": plot_name,\n",
    "        \"Easting_UTM\": point_utm.x,\n",
    "        \"Northing_UTM\": point_utm.y,\n",
    "        \"Longitude_CHEL\": point_wgs84.x,\n",
    "        \"Latitude_CHEL\": point_wgs84.y,\n",
    "        \"CRS_original\": str(gdf.crs)\n",
    "    })\n",
    "\n",
    "# ============================================================\n",
    "# ERGEBNISTABELLE ERSTELLEN\n",
    "# ============================================================\n",
    "\n",
    "plot_coordinates = pd.DataFrame(results)\n",
    "\n",
    "print(\"\\nFertig.\\n\")\n",
    "print(plot_coordinates)\n",
    "\n",
    "plot_coordinates"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "215a5fce-56ce-4636-b098-659dc986c55a",
   "metadata": {},
   "source": [
    "Für jeden der sechs Untersuchungsplots wird die jeweilige Stemmap eingelesen und ein gültiger Punkt ausgewählt. Die ursprünglich in UTM gespeicherten Koordinaten werden anschließend in geographische WGS84-Koordinaten transformiert. Diese Longitude- und Latitude-Werte dienen später zur räumlichen Zuordnung der CHELSA-Klimadaten. Zusätzlich werden die ursprünglichen UTM-Koordinaten und das verwendete Koordinatensystem zur Kontrolle gespeichert."
   ]
  },
