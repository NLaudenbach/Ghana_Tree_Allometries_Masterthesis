    "import rasterio\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "# ============================================================\n",
    "# EINSTELLUNGEN\n",
    "# ============================================================\n",
    "\n",
    "START_YEAR = 1991\n",
    "END_YEAR = 2020\n",
    "\n",
    "variables = [\n",
    "    \"tas\",\n",
    "    \"tasmax\",\n",
    "    \"tasmin\",\n",
    "    \"pr\",\n",
    "    \"cmi\",\n",
    "    \"pet\",\n",
    "    \"vpd\"\n",
    "]\n",
    "\n",
    "BASE_URL = (\n",
    "    \"https://os.unil.cloud.switch.ch/chelsa02/\"\n",
    "    \"chelsa/global/monthly\"\n",
    ")\n",
    "\n",
    "# Plotkoordinaten einmal vorbereiten\n",
    "coords = list(\n",
    "    zip(\n",
    "        plot_coordinates[\"Longitude_CHEL\"],\n",
    "        plot_coordinates[\"Latitude_CHEL\"]\n",
    "    )\n",
    ")\n",
    "\n",
    "plot_names = plot_coordinates[\"plot\"].tolist()\n",
    "\n",
    "# ============================================================\n",
    "# ALLE MONATSWERTE LADEN\n",
    "# JEDES RASTER WIRD NUR EINMAL GEÖFFNET\n",
    "# ============================================================\n",
    "\n",
    "monthly_results = []\n",
    "\n",
    "for year in range(START_YEAR, END_YEAR + 1):\n",
    "\n",
    "    print(f\"Jahr {year}\")\n",
    "\n",
    "    for month in range(1, 13):\n",
    "\n",
    "        # Zwischenspeicher für diesen Monat\n",
    "        month_data = {\n",
    "            plot: {\n",
    "                \"plot\": plot,\n",
    "                \"year\": year,\n",
    "                \"month\": month\n",
    "            }\n",
    "            for plot in plot_names\n",
    "        }\n",
    "\n",
    "        for variable in variables:\n",
    "\n",
    "            url = (\n",
    "                f\"{BASE_URL}/{variable}/{year}/\"\n",
    "                f\"CHELSA_{variable}_{month:02d}_{year}_V.2.1.tif\"\n",
    "            )\n",
    "\n",
    "            with rasterio.open(url) as src:\n",
    "\n",
    "                scale = src.scales[0]\n",
    "                offset = src.offsets[0]\n",
    "                nodata = src.nodata\n",
    "\n",
    "                # ALLE 6 Plotpunkte gleichzeitig auslesen\n",
    "                raw_values = list(src.sample(coords))\n",
    "\n",
    "                for plot, raw in zip(plot_names, raw_values):\n",
    "\n",
    "                    raw_value = raw[0]\n",
    "\n",
    "                    if raw_value == nodata:\n",
    "                        value = np.nan\n",
    "                    else:\n",
    "                        value = raw_value * scale + offset\n",
    "\n",
    "                    month_data[plot][variable] = value\n",
    "\n",
    "        monthly_results.extend(month_data.values())\n",
    "\n",
    "monthly_chelsa = pd.DataFrame(monthly_results)\n",
    "\n",
    "print(\"Fertig.\")\n",
    "monthly_chelsa.head()"
   ]
  },
