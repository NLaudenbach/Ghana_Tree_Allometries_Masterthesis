   "source": [
    "import pandas as pd\n",
    "\n",
    "# ============================================================\n",
    "# PFADE\n",
    "# ============================================================\n",
    "\n",
    "input_file = (\n",
    "    r\"Z:\\Ghana\\RCT_outputs\\KO4_preseg_RCT\\output\\rct\\segmented\"\n",
    "    r\"\\KO4_Trees_Inventory\\KO4_tree_inventory_master_TH.xlsx\"\n",
    ")\n",
    "\n",
    "output_file = (\n",
    "    r\"Z:\\Ghana\\RCT_outputs\\KO4_preseg_RCT\\output\\rct\\segmented\"\n",
    "    r\"\\KO4_Trees_Inventory\\KO4_tree_inventory_master_TH_CHEL.xlsx\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. BAUMINVENTAR LADEN\n",
    "# ============================================================\n",
    "\n",
    "trees = pd.read_excel(input_file)\n",
    "\n",
    "print(\"Bäume:\", len(trees))\n",
    "print(\"\\nVorhandene PID-Werte:\")\n",
    "print(trees[\"PID\"].value_counts(dropna=False))\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. PLOTNAMEN DER CHELSA-TABELLE AN PID ANPASSEN\n",
    "# ============================================================\n",
    "\n",
    "plot_to_pid = {\n",
    "    \"ANK-1\": \"ANK-01\",\n",
    "    \"BOB-1\": \"BOB-01\",\n",
    "    \"BOB-2\": \"BOB-02\",\n",
    "    \"KOG-2\": \"KO-02\",\n",
    "    \"KOG-4\": \"KO-04\",\n",
    "    \"KOG-5\": \"KO-05\"\n",
    "}\n",
    "\n",
    "# Kopie erstellen, damit chelsa_final unverändert bleibt\n",
    "chelsa_for_join = chelsa_final.copy()\n",
    "\n",
    "# Passenden PID-Schlüssel erzeugen\n",
    "chelsa_for_join[\"PID\"] = chelsa_for_join[\"plot\"].map(plot_to_pid)\n",
    "\n",
    "print(\"\\nZuordnung CHELSA -> PID:\")\n",
    "print(chelsa_for_join[[\"plot\", \"PID\"]])\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. NICHT BENÖTIGTE JOIN-SPALTE ENTFERNEN\n",
    "# ============================================================\n",
    "\n",
    "# Die CHELSA-Spalte \"plot\" brauchen wir nach dem Mapping\n",
    "# nicht zusätzlich im Bauminventar.\n",
    "chelsa_for_join = chelsa_for_join.drop(columns=[\"plot\"])\n",
    "\n",
    "# Falls Koordinaten in chelsa_final enthalten sind und NICHT\n",
    "# an jeden Baum angehängt werden sollen, entfernen:\n",
    "columns_to_remove = [\n",
    "    \"Easting_UTM\",\n",
    "    \"Northing_UTM\",\n",
    "    \"Longitude_CHEL\",\n",
    "    \"Latitude_CHEL\",\n",
    "    \"CRS_original\"\n",
    "]\n",
    "\n",
    "chelsa_for_join = chelsa_for_join.drop(\n",
    "    columns=[\n",
    "        col for col in columns_to_remove\n",
    "        if col in chelsa_for_join.columns\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. CHELSA-DATEN AN JEDEN BAUM ANHÄNGEN\n",
    "# ============================================================\n",
    "\n",
    "trees_with_chelsa = trees.merge(\n",
    "    chelsa_for_join,\n",
    "    on=\"PID\",\n",
    "    how=\"left\",\n",
    "    validate=\"many_to_one\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. KONTROLLE\n",
    "# ============================================================\n",
    "\n",
    "print(\"\\nBäume vorher:\", len(trees))\n",
    "print(\"Bäume nach Join:\", len(trees_with_chelsa))\n",
    "\n",
    "print(\"\\nAnzahl Bäume pro PID:\")\n",
    "print(trees_with_chelsa[\"PID\"].value_counts(dropna=False))\n",
    "\n",
    "# CHELSA-Spalten bestimmen\n",
    "chelsa_columns = [\n",
    "    col for col in chelsa_for_join.columns\n",
    "    if col != \"PID\"\n",
    "]\n",
    "\n",
    "print(\"\\nFehlende CHELSA-Zuordnungen pro Spalte:\")\n",
    "print(trees_with_chelsa[chelsa_columns].isna().sum())\n",
    "\n",
    "# Kontrolle der Kombination PID + Klimawerte\n",
    "display(\n",
    "    trees_with_chelsa[\n",
    "        [\"PID\"] + chelsa_columns\n",
    "    ].drop_duplicates()\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. SPEICHERN\n",
    "# ============================================================\n",
    "\n",
    "trees_with_chelsa.to_excel(\n",
    "    output_file,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "print(\"\\nFertig.\")\n",
    "print(\"Gespeichert unter:\")\n",
    "print(output_file)"
