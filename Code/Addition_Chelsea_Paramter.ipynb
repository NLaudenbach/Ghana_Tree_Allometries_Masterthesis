   "source": [
    "# ============================================================\n",
    "# 1. EINHEITEN UMWANDELN\n",
    "# ============================================================\n",
    "\n",
    "climate = monthly_chelsa_1989_2018.copy()\n",
    "\n",
    "# Temperatur: Kelvin -> °C\n",
    "climate[\"tas_C\"] = climate[\"tas\"] - 273.15\n",
    "climate[\"tasmax_C\"] = climate[\"tasmax\"] - 273.15\n",
    "climate[\"tasmin_C\"] = climate[\"tasmin\"] - 273.15\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. KLIMATOLOGISCHE MONATSMITTEL 1989–2018\n",
    "# ============================================================\n",
    "\n",
    "# Für jeden Plot und jeden Kalendermonat wird\n",
    "# der Mittelwert über die 30 Jahre gebildet.\n",
    "\n",
    "monthly_climatology = (\n",
    "    climate\n",
    "    .groupby([\"plot\", \"month\"], as_index=False)\n",
    "    .agg({\n",
    "        \"tas_C\": \"mean\",\n",
    "        \"tasmax_C\": \"mean\",\n",
    "        \"tasmin_C\": \"mean\",\n",
    "        \"pr\": \"mean\",\n",
    "        \"cmi\": \"mean\",\n",
    "        \"pet\": \"mean\",\n",
    "        \"vpd\": \"mean\"\n",
    "    })\n",
    ")\n",
    "\n",
    "print(\"Klimatologische Monatswerte:\")\n",
    "print(monthly_climatology.head())\n",
    "\n",
    "print(\"\\nZeilen:\")\n",
    "print(len(monthly_climatology))\n",
    "# Erwartet: 6 Plots × 12 Monate = 72\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. FINALE KLIMAPARAMETER PRO PLOT BERECHNEN\n",
    "# ============================================================\n",
    "\n",
    "final_results = []\n",
    "\n",
    "for plot, df in monthly_climatology.groupby(\"plot\"):\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Temperature Seasonality\n",
    "    # Standardabweichung der 12 klimatologischen Monatsmittel\n",
    "    # × 100\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    temperature_seasonality = (\n",
    "        df[\"tas_C\"].std(ddof=0) * 100\n",
    "    )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Precipitation Seasonality\n",
    "    # Variationskoeffizient der 12 klimatologischen\n",
    "    # Monatsniederschläge\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    precipitation_seasonality = (\n",
    "        df[\"pr\"].std(ddof=0)\n",
    "        / df[\"pr\"].mean()\n",
    "        * 100\n",
    "    )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Mittlere Jahrestemperatur\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    mean_annual_temperature = df[\"tas_C\"].mean()\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Mittlerer Jahresniederschlag\n",
    "    # Summe der 12 klimatologischen Monatsniederschläge\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    annual_precipitation = df[\"pr\"].sum()\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Weitere langfristige Klimaparameter\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    mean_tasmax = df[\"tasmax_C\"].mean()\n",
    "    mean_tasmin = df[\"tasmin_C\"].mean()\n",
    "\n",
    "    mean_cmi = df[\"cmi\"].mean()\n",
    "    mean_pet = df[\"pet\"].mean()\n",
    "    mean_vpd = df[\"vpd\"].mean()\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Ergebnis speichern\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    final_results.append({\n",
    "        \"plot\": plot,\n",
    "        \"Temperature_Seasonality_CHEL\": temperature_seasonality,\n",
    "        \"Precipitation_Seasonality_CHEL\": precipitation_seasonality,\n",
    "        \"Mean_Annual_Temperature_CHEL\": mean_annual_temperature,\n",
    "        \"Annual_Precipitation_CHEL\": annual_precipitation,\n",
    "        \"Mean_Tasmax_CHEL\": mean_tasmax,\n",
    "        \"Mean_Tasmin_CHEL\": mean_tasmin,\n",
    "        \"Mean_CMI_CHEL\": mean_cmi,\n",
    "        \"Mean_PET_CHEL\": mean_pet,\n",
    "        \"Mean_VPD_CHEL\": mean_vpd\n",
    "    })\n",
    "\n",
    "\n",
   "# ============================================================\n",
    "# 4. FINALE TABELLE ERSTELLEN\n",
    "# ============================================================\n",
    "\n",
    "chelsa_final = pd.DataFrame(final_results)\n",
    "\n",
    "chelsa_final = chelsa_final.sort_values(\n",
    "    \"plot\"\n",
    ").reset_index(drop=True)\n",
    "\n",
    "print(\"\\nFinale CHELSA-Tabelle:\")\n",
    "\n",
    "chelsa_final = plot_coordinates.merge(\n",
    "    chelsa_final,\n",
    "    on=\"plot\",\n",
    "    how=\"left\"\n",
    ")\n",
    "\n",
    "display(chelsa_final)"
   ]
  },
