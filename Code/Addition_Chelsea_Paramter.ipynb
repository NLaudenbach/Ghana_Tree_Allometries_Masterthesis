    "# ============================================================\n",
    "# TEST: CHELSA tas – Januar 2020\n",
    "# ============================================================\n",
    "\n",
    "url = (\n",
    "    \"https://os.unil.cloud.switch.ch/chelsa02/\"\n",
    "    \"chelsa/global/monthly/tas/2020/\"\n",
    "    \"CHELSA_tas_01_2020_V.2.1.tif\"\n",
    ")\n",
    "\n",
    "test_results = []\n",
    "\n",
    "with rasterio.open(url) as src:\n",
    "\n",
    "    scale = src.scales[0]\n",
    "    offset = src.offsets[0]\n",
    "    nodata = src.nodata\n",
    "\n",
    "    for _, row in plot_coordinates.iterrows():\n",
    "\n",
    "        lon = row[\"Longitude_CHEL\"]\n",
    "        lat = row[\"Latitude_CHEL\"]\n",
    "\n",
    "        raw_value = list(src.sample([(lon, lat)]))[0][0]\n",
    "\n",
    "        if raw_value == nodata:\n",
    "            temp_k = None\n",
    "            temp_c = None\n",
    "        else:\n",
    "            temp_k = raw_value * scale + offset\n",
    "            temp_c = temp_k - 273.15\n",
    "\n",
    "        test_results.append({\n",
    "            \"plot\": row[\"plot\"],\n",
    "            \"tas_Jan2020_K\": temp_k,\n",
    "            \"tas_Jan2020_C\": temp_c\n",
    "        })\n",
    "\n",
    "test_chelsa = pd.DataFrame(test_results)\n",
    "\n",
    "test_chelsa"
   ]
  },
  {
   "cell_type": "markdown",
